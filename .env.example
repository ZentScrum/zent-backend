# ==============================================================================
# Zent Anti-Phishing Platform - Environment Configuration Template (Production & Staging)
# ==============================================================================
# Copia este archivo como '.env' en tu servidor productivo y configura los valores secretos.
# NUNCA subas el archivo '.env' real al repositorio Git.

# --- 1. Configuración de Seguridad Central de Django ---
# Genera una clave segura de al menos 50 caracteres para producción:
SECRET_KEY=zent-production-security-secret-key-change-this-in-cloud-deployment-2026-secure

# Para producción DEBE ser False:
DEBUG=False

# Dominios y subdominios autorizados (separados por coma, sin espacios):
ALLOWED_HOSTS=api.zent.security,zent-backend-production.up.railway.app,localhost,127.0.0.1,192.168.18.57

# --- 2. Base de Datos Productiva (Supabase PostgreSQL / Cloud) ---
# Formato Supabase Connection Pooling (Modo Transaction o Session con sslmode=require):
# DATABASE_URL=postgresql://postgres.xxxxxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///db.sqlite3

# --- 3. Cabeceras CORS y Orígenes Web Autorizados ---
# Orígenes web autorizados para el Dashboard Angular y clientes web:
CORS_ALLOWED_ORIGINS=https://admin.zent.security,http://localhost:4200,http://127.0.0.1:4200

# --- 4. Pasarelas de Inteligencia de Amenazas (Opcionales en Fase Inicial) ---
# Google Safe Browsing API v4 (https://console.cloud.google.com/)
GOOGLE_SAFE_BROWSING_API_KEY=

# VirusTotal API v3 (https://www.virustotal.com/)
VIRUSTOTAL_API_KEY=
